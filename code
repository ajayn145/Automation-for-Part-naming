
import re
def split_string(part_name):
    
    # Split the string by backslash (\) to get the last part
    parts = part_name.split('\\')
    last_part = parts[-1]

    # Split the last part by forward slash (/)
    sub_parts = last_part.split('/')

    # Get the part before the last forward slash (if exists)
    name_before_last_slash = sub_parts[0]

    # Remove consecutive occurrences of special characters
    name_without_special_chars = re.sub(r'([*_:;"<>,.?+=-])\1+', r'\1', name_before_last_slash)

    # Check if "RH", "R", "L", or "LH" appear at the end and remove them
    name_without_special_chars = re.sub(r'(_RH|_LEFT|_RIGHT|_R|_L|_LH|_LHD|RH|LH|LEFT|RIGHT|-RH|-LEFT|-RIGHT|-R|-L|-LH|-LEFT|-RIGHT)$', '', name_without_special_chars)

    # Remove "HL_" or "RL_" from the beginning of the name
    name_without_prefix = re.sub(r'^(HL_|RL_|RL|HL)', '', name_without_special_chars)
    
    # Remove integers from the name
    name_without_integers = re.sub(r'\d', '', name_without_prefix)
    names_without_space = name_without_integers.replace(" ", "")
    final_part_name = names_without_space 
    
    
    #mesh_names = ["air", "lens", "housing", "cap", "box", "vent", "heatsink", "reflector", "bezel", "inner", "screen", "fresnel", "lightguide", "lightbar", "flatguide", "bulbshield", "heatshield", "glue", "socle", "bulbholder", "gasket", "circuit", "led", "pcb", "vias", "driver", "fan"]

    #if final_part_name_updated.lower() in [s.lower() for s in mesh_names]:
      #  final_part_name_updated = final_part_name_updated + "-"
    #else 
    
    # Loop for preventing duplicate naming
    prefix_a = "s"
    prefix_b = "-"
    prefix_sum = prefix_a+prefix_b
    
    if final_part_name[0] == "s":
        return final_part_name
    else:
        final_part_name_updated = prefix_sum + final_part_name
    
    return  final_part_name_updated


